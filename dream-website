      <div class="code-window"><div class="window-head"><i class="dot"></i><i class="dot"></i><i class="dot"></i><span class="filename">my-first-project.js</span></div><div class="code-body"><div><span class="purple">const</span> dream = <span class="green">"مطور المستقبل"</span>;</div><div><span class="purple">function</span> <span class="orange">startJourney</span>() {</div><div>&nbsp;&nbsp;console.log(<span class="green">"أول خطوة!"</span>);</div><div>&nbsp;&nbsp;<span class="purple">return</span> dream;</div><div>}</div><div style="margin-top:13px;color:#8792b5">// كل مشروع بيبدأ بفكرة صغيرة ✨</div><div><span class="orange">startJourney</span>(); <span style="color:#9de5b1">▍</span></div></div></div>
